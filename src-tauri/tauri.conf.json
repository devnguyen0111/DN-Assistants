{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DN Assistant",
  "version": "0.1.1",
  "identifier": "com.dn.assistant",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DN Assistant",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com https://open.er-api.com https://latest.currency-api.pages.dev https://cdn.jsdelivr.net https://api.frankfurter.app https://api.frankfurter.dev https://api.ipify.org https://ipapi.co; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:dn-assistant.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0OEFFMDYyNkJCMUEzNzMKUldSem83RnJZdUNLbE1KNkd4b1ZaVkpaRlI1RUVvOVFGRDVOeTZzUTlCUVIvZ0kvV2NDYXk2N1QK",
      "endpoints": ["https://github.com/devnguyen0111/DN-Assistants/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "DevNguyen",
    "copyright": "Copyright © DevNguyen",
    "category": "Utility",
    "shortDescription": "DN Assistant desktop utilities",
    "longDescription": "DN Assistant is a desktop productivity companion offering system monitoring, clipboard history, calendar, focus timer, currency conversion, weather, and network tools in one lightweight app.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Vietnamese"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
